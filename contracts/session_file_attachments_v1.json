    "common_ref": "ccdd318",
    "file_layer_ref": "1526271",
    "runtime_dependency": "TimurKady/cortex-runtime#24 is not implemented; the outbound chat::answer below is the Edge #6 contract shape, not an observed Runtime message"
  },
  "limits": {
    "max_attachments_per_message": 8,
    "max_public_attachments_per_message": 16
  },
