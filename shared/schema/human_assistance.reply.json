{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request_id", "client_reply_id", "action"],
  "properties": {
    "version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "client_reply_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "action": {"enum": ["answer", "refuse"]},
    "option_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "answer"}}},
     "then": {"anyOf": [{"required": ["option_id"]}, {"required": ["text"]}]}},
    {"if": {"properties": {"action": {"const": "refuse"}}},
     "then": {"not": {"anyOf": [{"required": ["option_id"]}, {"required": ["text"]}]}}}
  ]
}
