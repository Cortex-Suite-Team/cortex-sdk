{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.local/sdk/schema/chat.echo.json",
  "title": "chat::echo Payload",
  "description": "Runtime echo/ack of user input as serialized by Runtime ChatEchoPayload.to_dict(). Used to reconcile an optimistic user message and does not terminate the assistant turn. role=operator echoes an operator escalation reply and owns no files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "role"],
  "properties": {
    "content": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Echoed text blocks, in order"
    },
    "role": {
      "type": "string",
      "enum": ["user", "operator"],
      "description": "user for an echoed chat::message; operator for an echoed escalation reply"
    },
    "turn": {
      "type": "integer",
      "minimum": 0,
      "description": "Turn number; absent when the echo is not tied to a turn"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_ref", "filename", "content_type", "size", "owner_role", "direction", "state", "message_ref", "message_ref_kind"],
            "properties": {
              "file_ref": {
                "type": "string",
                "pattern": "^sf_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "content_type": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "owner_role": {
                "type": "string",
                "const": "user"
              },
              "direction": {
                "type": "string",
                "const": "inbound"
              },
              "state": {
                "type": "string",
                "enum": ["available", "expired", "deleted", "quarantined"]
              },
              "message_ref": {
                "type": "string",
                "pattern": "^(?!fi_|sn_)."
              },
              "message_ref_kind": {
                "type": "string",
                "const": "client_msg_id"
              }
            }
          },
          "description": "Ordered public descriptors of the files the user attached to the echoed message (message_ref = meta.client_msg_id)."
        }
      }
    }
  },
  "if": {
    "properties": { "role": { "const": "operator" } }
  },
  "then": {
    "properties": {
      "meta": {
        "properties": { "attachments": { "maxItems": 0 } }
      }
    }
  }
}
