{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.local/sdk/schema/chat.echo.json",
  "title": "chat::echo Payload",
  "description": "Runtime echo/ack of user input. Used to reconcile an optimistic user message and does not terminate the assistant turn.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role"],
  "properties": {
    "content": {
      "description": "User-visible echoed content",
      "type": ["string", "array", "object", "number", "boolean", "null"]
    },
    "message": {
      "description": "Optional structured echoed payload when content is not provided"
    },
    "role": {
      "type": "string",
      "const": "user"
    },
    "turn_id": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_ref", "filename", "content_type", "size", "owner_role", "direction", "state", "message_ref", "message_ref_kind"],
            "properties": {
              "file_ref": {
                "type": "string",
                "pattern": "^sf_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "content_type": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "owner_role": {
                "type": "string",
                "const": "user"
              },
              "direction": {
                "type": "string",
                "const": "inbound"
              },
              "state": {
                "type": "string",
                "enum": ["available", "expired", "deleted", "quarantined"]
              },
              "message_ref": {
                "type": "string",
                "pattern": "^(?!fi_|sn_)."
              },
              "message_ref_kind": {
                "type": "string",
                "const": "client_msg_id"
              }
            }
          },
          "description": "Ordered public descriptors of the files the user attached to the echoed message (message_ref = meta.client_msg_id)."
        }
      }
    }
  },
  "anyOf": [
    {
      "required": ["content"]
    },
    {
      "required": ["message"]
    }
  ]
}
