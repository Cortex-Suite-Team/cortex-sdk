{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.local/sdk/schema/chat.answer.json",
  "title": "chat::answer Payload",
  "description": "Final answer as serialized by Runtime ChatAnswerPayload.to_dict(). Terminates a turn. Generated files arrive as public session-file descriptors in meta.attachments, bound to this answer's turn: message_ref = String(turn), message_ref_kind = turn.",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "role", "answer_kind"],
  "properties": {
    "content": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Visible answer text blocks, in order"
    },
    "role": {
      "type": "string",
      "enum": ["assistant", "operator"],
      "description": "assistant for runtime answers; operator when an operator closes the interaction"
    },
    "answer_kind": {
      "type": "string",
      "enum": ["final"],
      "description": "final = regular final answer"
    },
    "turn": {
      "type": "integer",
      "minimum": 0,
      "description": "Turn number; absent when the answer is not tied to a turn (for example an operator close)"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_ref", "filename", "content_type", "size", "owner_role", "direction", "state", "message_ref", "message_ref_kind"],
            "properties": {
              "file_ref": {
                "type": "string",
                "pattern": "^sf_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "content_type": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "owner_role": {
                "type": "string",
                "const": "assistant"
              },
              "direction": {
                "type": "string",
                "const": "outbound"
              },
              "state": {
                "type": "string",
                "enum": ["available", "expired", "deleted", "quarantined"]
              },
              "message_ref": {
                "type": "string",
                "pattern": "^(?!fi_|sn_)."
              },
              "message_ref_kind": {
                "type": "string",
                "const": "turn"
              }
            }
          },
          "description": "Ordered public descriptors of files generated for this answer (EA ceiling 8), re-projected by SessionManager from its own sf_ records. Never carries fi_/sn_ identity, scope, storage keys, tickets or URLs."
        }
      },
      "description": "Optional answer metadata. Runtime metadata keys (for example billing summaries) pass through; only meta.attachments is part of the public file contract."
    }
  }
}
