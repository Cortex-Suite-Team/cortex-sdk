{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex.local/sdk/schema/chat.message.json",
  "title": "chat::message Payload",
  "description": "User message sent to the runtime. Attachment refs use payload.meta.attachments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["content", "role"],
  "properties": {
    "content": {
      "description": "User-visible message content"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_ref"],
            "properties": {
              "file_ref": {
                "type": "string",
                "pattern": "^sf_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "filename": { "type": "string" },
              "content_type": { "type": "string" },
              "size": { "type": "number", "minimum": 0 }
            }
          },
          "description": "Canonical public session-file descriptors from uploadAttachment()."
        }
      },
      "description": "Optional user-message metadata"
    },
    "role": {
      "type": "string",
      "const": "user"
    }
  }
}
