{
  "name": "file_upload",
  "description": "Client uploads a file over the session WebSocket, receives a canonical file_ref, then sends a message with the attachment reference.",
  "steps": [
    {
      "direction": "client",
      "type": "system::init",
      "meta": {
        "client_msg_id": "cli_init_003"
      },
      "payload": {
        "execution_mode": "production",
        "bundle_url": "/api/runtime/releases/42/bundle/",
        "checksum": "sha256:release_42"
      },
      "note": "payload copied from runtime_bootstrap returned by /auth/token; session_id omitted on outbound system::init; SDK generates meta.client_msg_id"
    },
    {
      "direction": "server",
      "type": "system::opened",
      "payload": {
        "status": "initializing",
        "client_msg_id": "cli_init_003",
        "execution_mode": "production"
      },
      "note": "session_id: sess_abc123, seq: 1 — canonical bootstrap ack from SessionManager"
    },
    {
      "direction": "client",
      "type": "file::upload.prepare",
      "meta": { "client_msg_id": "cli_file_prepare_003" },
      "payload": { "filename": "report.pdf", "content_type": "application/pdf", "size": 3 }
    },
    {
      "direction": "server",
      "type": "file::upload.ready",
      "meta": { "client_msg_id": "cli_file_prepare_003" },
      "payload": { "transfer_id": "ft_01010101010101010101010101010101", "chunk_bytes": 262144, "max_bytes": 52428800 }
    },
    {
      "note": "--- BINARY: CFT1 transfer ft_01010101010101010101010101010101, sequence 0, payload 3 bytes ---"
    },
    {
      "direction": "client",
      "type": "file::upload.commit",
      "meta": { "client_msg_id": "cli_file_commit_003" },
      "payload": { "transfer_id": "ft_01010101010101010101010101010101" }
    },
    {
      "direction": "server",
      "type": "file::upload.complete",
      "meta": { "client_msg_id": "cli_file_commit_003" },
      "payload": { "transfer_id": "ft_01010101010101010101010101010101", "file_ref": "sf_xyz789" }
    },
    {
      "direction": "client",
      "type": "chat::message",
      "payload": {
        "content": "Please summarize this document.",
        "role": "user",
        "meta": {
          "attachments": [{ "file_ref": "sf_xyz789" }]
        }
      },
      "note": "session_id: sess_abc123 — canonical file_ref embedded at payload.meta.attachments after system::opened"
    },
    {
      "direction": "server",
      "type": "chat::answer",
      "payload": {
        "content": "The document covers three main topics: introduction, methodology, and conclusions.",
        "role": "assistant",
        "answer_kind": "final",
        "turn_id": "turn_006"
      },
      "note": "session_id: sess_abc123, seq: 2"
    }
  ]
}
